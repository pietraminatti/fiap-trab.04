AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=pt-BR

# --- Azure AI Language (Text Analytics: sentimento, frases-chave, Text Analytics for Health) ---
# Portal Azure > Criar recurso "Language service" > Chaves e Ponto de Extremidade
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/

# --- Entrega de alertas (opcional) ---
# URL de "Incoming Webhook" do Microsoft Teams ou do Slack. Alertas ALTO/CRÍTICO são enviados para ela.
ALERT_WEBHOOK_URL=
# Janela (min) em que o mesmo alerta não é repetido
ALERT_COOLDOWN_MIN=120
